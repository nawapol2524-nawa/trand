  "pipeline_architecture": {
    "stages_in_order": [
      {
        "order": 1,
        "stage": "MARKET_DATA",
        "description": "UTC-synchronized OHLCV bar and real-time tick/spread aggregation",
        "authority": "Deterministic Data Ingestion"
      },
      {
        "order": 2,
        "stage": "TECHNICAL_SIGNAL",
        "description": "Rule-based signal generation using EMA 9/21/200, Wilder RSI, ATR 14, and BOS N=20 on M5",
        "authority": "Deterministic Strategy Engine"
      },
      {
        "order": 3,
        "stage": "QUANTITATIVE_REGIME_EVALUATION",
        "description": "Calculates ml_probability, trend regime, and volatility state",
        "authority": "Quantitative Analysis"
      },
      {
        "order": 4,
        "stage": "LLM_ADVISORY_LAYER",
        "description": "Enriches setup with qualitative market structure context; generates TradeProposal advisory (APPROVE, REJECT, HOLD, PASS, UNAVAILABLE). ZERO final order authority.",
        "authority": "Advisory / Context Only"
      },
      {
        "order": 5,
        "stage": "DETERMINISTIC_RISK_AND_EXECUTION_GATE",
        "description": "Evaluates hard boundaries (News Blackout, Spread, Slippage, Drawdown, Daily Loss, Circuit Breaker, Staleness, Kill Switch). Holds sovereign veto authority.",
        "authority": "Absolute Sovereign Authority"
      },
      {
        "order": 6,
        "stage": "FINAL_DECISION",
        "description": "Produces typed FinalDecision (BUY, SELL, HOLD, BLOCK) and canonical BlockReason if blocked",
        "authority": "Deterministic Gatekeeper"
      },
      {
        "order": 7,
        "stage": "EXECUTION_ROUTING",
        "description": "Computes lot sizing via frozen risk parameters (1.0% base) and transmits order to broker FIX API",
        "authority": "Broker Interface"
      }
    ]
  },
