# ==========================================
# 🔐 SECRETS & CREDENTIALS
# ==========================================
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
*.secret
credentials.json

# ==========================================
# 🧠 MODEL BINARIES & CHECKPOINTS
# ==========================================
artifacts/models/*.joblib
!artifacts/models/candidate_*.joblib
!artifacts/models/.gitkeep
artifacts/scalers/*.joblib
!artifacts/scalers/.gitkeep

# ==========================================
# 📊 LARGE DATA & PARQUET (OFFLINE ONLY)
# ==========================================
/data/
*.parquet
*.parquet.tmp
artifacts/state/*.tmp

# ==========================================
# 📝 LOGS & RUNTIME DATABASES
# ==========================================
/logs/
/state/
*.log
*.jsonl
*.sqlite3

# ==========================================
# 🐍 PYTHON BUILD & CACHE
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv
env/
venv/
ENV/
.DS_Store
.idea/
.vscode/
*.zip
