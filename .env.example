# ===========================================================
# Trading Bot — Environment Configuration Template
# Copy to .env and fill in your values
# NEVER commit .env to git — it is in .gitignore
# ===========================================================

# -----------------------------------------------------------
# TRADING MODE — CRITICAL SAFETY CONTROL
# -----------------------------------------------------------
# PAPER = real market data, simulated orders (default, safe)
# DEMO  = real connection to Deriv cTrader DEMO account
# LIVE  = requires BOTH TRADING_MODE=LIVE AND LIVE_TRADING_ENABLED=true
TRADING_MODE=PAPER

# LIVE SAFETY LOCK — must be exactly "true" to enable live trading
# Requires TRADING_MODE=LIVE to also be set
LIVE_TRADING_ENABLED=false

# -----------------------------------------------------------
# cTRADER OPEN API — get from https://openapi.ctrader.com/
# -----------------------------------------------------------
# Register an application, complete OAuth flow for account below
CTRADER_CLIENT_ID=YOUR_CTRADER_CLIENT_ID
CTRADER_CLIENT_SECRET=YOUR_CTRADER_CLIENT_SECRET
CTRADER_ACCESS_TOKEN=YOUR_OAUTH_ACCESS_TOKEN
CTRADER_ACCOUNT_ID=YOUR_CTRADER_LOGIN_ID
CTRADER_HOST=demo.ctraderapi.com
CTRADER_PORT=5035

# -----------------------------------------------------------
# DERIV WEBSOCKET API — https://app.deriv.com/account/api-token
# -----------------------------------------------------------
DERIV_API_TOKEN=YOUR_DERIV_API_TOKEN
DERIV_APP_ID=YOUR_DERIV_APP_ID

# -----------------------------------------------------------
# NOTIFICATIONS — Optional
# -----------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_USER_ID=YOUR_LINE_USER_ID

# -----------------------------------------------------------
# LOGGING & PATHS
# -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
STATE_DIR=./state

# -----------------------------------------------------------
# RISK PARAMETERS — see RISK_MODEL.md
# -----------------------------------------------------------
RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.05
MAX_CONSECUTIVE_LOSSES=5
MAX_OPEN_POSITIONS=3
EMERGENCY_KILL_SWITCH=false
