# ===========================================================
# Trading Bot — Environment Configuration Template
# For 24/7 DEMO Deployment (Railway / Docker / Local)
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit your actual .env file to git (enforced by .gitignore).
# 2. NEVER configure LIVE_TRADING_ENABLED=true on Railway Demo.
# 3. Only set values via Railway Dashboard Variables or local .env.
# ===========================================================

# -----------------------------------------------------------
# 1. TRADING MODE & SAFETY LOCK (CRITICAL)
# -----------------------------------------------------------
# Options: DEMO (recommended for Railway), PAPER, LIVE
# Note: LIVE mode is strictly blocked unless LIVE_TRADING_ENABLED=true
TRADING_MODE=DEMO

# LIVE SAFETY LOCK — must remain "false" for Demo testing
LIVE_TRADING_ENABLED=false

# -----------------------------------------------------------
# 2. BROKER CONNECTIVITY — Deriv cTrader Remote MCP
# -----------------------------------------------------------
# Endpoint URL for cTrader Remote MCP Server
CTRADER_MCP_URL=https://mcp.ctrader.com/trading/mcp

# Bearer Token for cTrader MCP (issued from Deriv / cTrader portal)
# Format: Bearer eyJ...
CTRADER_MCP_TOKEN=YOUR_CTRADER_MCP_BEARER_TOKEN

# -----------------------------------------------------------
# 3. AI LAYER PROVIDER KEYS (OPTIONAL / ADVISORY ONLY)
# -----------------------------------------------------------
# Primary Provider: groq (recommended for speed) or openai
PRIMARY_AI_PROVIDER=groq
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Secondary Provider (Fallback)
SECONDARY_AI_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# -----------------------------------------------------------
# 4. RUNTIME & SCHEDULING CONFIGURATION
# -----------------------------------------------------------
# Cycle evaluation interval in seconds (default: 5.0s)
CYCLE_INTERVAL=5.0

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Paths for Railway volume persistence (defaults to ./logs and ./state)
LOG_DIR=/app/logs
STATE_DIR=/app/state

# Healthcheck heartbeat staleness threshold in seconds (default: 60.0s)
HEALTHCHECK_MAX_STALE_SECONDS=60.0

# Maximum tolerable broker disconnect duration before healthcheck reports unhealthy (seconds)
HEALTHCHECK_MAX_DISCONNECT_SECONDS=180.0

# -----------------------------------------------------------
# 5. HARD RISK CONTROLS (FROZEN — see RISK_MODEL.md)
# -----------------------------------------------------------
# Risk per trade as fraction of equity (0.01 = 1.0%)
RISK_PER_TRADE_PCT=0.01

# Maximum cumulative daily loss fraction before trading halts for day (0.05 = 5.0%)
MAX_DAILY_LOSS_PCT=0.05

# Maximum consecutive losses before 1-hour circuit breaker halt
MAX_CONSECUTIVE_LOSSES=5

# Maximum concurrent open positions across all instruments
MAX_OPEN_POSITIONS=3

# Immediate emergency circuit breaker (true = halts all new orders immediately)
EMERGENCY_KILL_SWITCH=false
